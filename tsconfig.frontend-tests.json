{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".tmp/frontend-unit-tests",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/config/hskQuestionTypes.ts",
