    "src/utils/hskQuestionBankFilters.ts",
    "src/utils/hskQuestionDetailRoute.ts",
    "src/utils/hskQuestionTypeChangeGuard.ts",
    "src/utils/hskPaperDeleteDecision.ts",
    "src/utils/hskPaperListState.ts",
    "src/utils/hskQuestionTypeSave.ts",
    "src/utils/mediaPresentation.ts",
    "src/types/hskExams.ts"
  ],
  "exclude": ["node_modules", ".tmp", "dist"]
}
