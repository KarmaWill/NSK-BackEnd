# 可选：显式指定 API 地址（不设则开发模式走 Vite 代理 /api → localhost:3000）
# VITE_API_BASE_URL=http://localhost:3000

# 无后端时仅调试 UI：在项目根目录复制为 .env.local 并取消下行注释
# VITE_DEV_SKIP_AUTH=1

# 后端配置见 server/.env.example（server 独立包，默认监听 3000）

# Java HSK 网关（本地联调走 Vite 代理时可不设；直连生产/测试网关时启用，token 放 .env.local）
# VITE_CLINGO_ADMIN_API_BASE_URL=https://admin.clingoaios.com/api/clingo
# VITE_CLINGO_EXAM_API_BASE_URL=https://api.clingoaios.com/api/clingo
# VITE_CLINGO_GATEWAY_TOKEN=login_...
